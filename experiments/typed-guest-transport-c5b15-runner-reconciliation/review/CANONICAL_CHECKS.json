  {
    "check": "lint",
    "command": [
      "pnpm",
      "lint"
    ],
    "exit": 0
  },
  {
    "check": "test",
    "command": [
      "pnpm",
      "test"
    ],
    "exit": 0
  },
  {
    "check": "schemas",
    "command": [
      "pnpm",
      "verify:schemas"
    ],
    "exit": 0
  },
  {
    "check": "adrs",
    "command": [
      "pnpm",
      "verify:adrs"
    ],
    "exit": 0
