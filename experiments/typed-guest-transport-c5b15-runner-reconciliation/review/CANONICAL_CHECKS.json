    "exit": 0
  },
  {
    "check": "golangci-ratchet",
    "command": [
      "golangci-lint",
      "run",
      "--enable-only",
      "revive",
      "--new-from-rev=origin/main",
      "./..."
    ],
    "exit": 0
  },
  {
    "check": "govulncheck",
    "command": [
      "go",
      "run",
      "golang.org/x/vuln/cmd/govulncheck@v1.6.0",
      "./..."
    ],
    "exit": 0
  }
